generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
}

enum TeamRole {
  OWNER
  EDITOR
  VIEWER
}

enum BudgetStatus {
  ACTIVE
  CLOSED
}

// ------------------------------------------------------
// USER & AUTHENTICATION
// ------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?  @map("password_hash") // Opcional para login exclusivo con Google
  googleId     String?  @unique @map("google_id")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  avatarUrl    String?  @map("avatar_url")
  isActive     Boolean  @default(true) @map("is_active")
  isVerify     Boolean  @default(false) @map("is_verify")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relaciones de sistema
  session   UserSession?
  auditLogs AuditLog[]

  // Relaciones financieras y de equipo
  ownedTeams        Team[]                       @relation("TeamOwner")
  teamMemberships   TeamMember[]
  incomes           Income[]
  itemAllocations   BudgetItemAllocation[]
  expensesPaid      Expense[]                    @relation("ExpensePayer")
  expensesCreated   Expense[]                    @relation("ExpenseCreator")
  closingRemainders BudgetClosingUserRemainder[]

  @@map("users")
}

model UserSession {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

// ------------------------------------------------------
// MONEDAS (CURRENCIES)
// ------------------------------------------------------

model Currency {
  id        String   @id @default(uuid())
  code      String   @unique @db.VarChar(10)
  name      String   @db.VarChar(100)
  symbol    String   @db.VarChar(10)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  teams Team[]

  @@map("currencies")
}

// ------------------------------------------------------
// TEAMS & ROLES (RBAC POR ESPACIO DE TRABAJO)
// ------------------------------------------------------

model Team {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  isPersonal  Boolean  @default(true) @map("is_personal") // True si es su espacio individual inicial
  ownerId     String   @map("owner_id")
  currencyId  String?  @map("currency_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner            User             @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  currency         Currency?        @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  members          TeamMember[]
  incomeCategories IncomeCategory[]
  budgets          Budget[]

  @@map("teams")
}

model TeamMember {
  id       String   @id @default(uuid())
  teamId   String   @map("team_id")
  userId   String   @map("user_id")
  role     TeamRole @default(VIEWER)
  joinedAt DateTime @default(now()) @map("joined_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

// ------------------------------------------------------
// INGRESOS Y CATEGORÍAS
// ------------------------------------------------------

model IncomeCategory {
  id        String   @id @default(uuid())
  teamId    String   @map("team_id")
  name      String // Ej: "Salario mensual", "Licencias", "Sobrante presupuesto"
  isSystem  Boolean  @default(false) @map("is_system") // Para proteger la categoría de sobrantes
  createdAt DateTime @default(now()) @map("created_at")

  team    Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  incomes Income[]

  @@unique([teamId, name])
  @@map("income_categories")
}

model Income {
  id          String   @id @default(uuid())
  budgetId    String   @map("budget_id")
  categoryId  String   @map("category_id")
  userId      String   @map("user_id") // A quién pertenece este ingreso dentro del team
  amount      Decimal  @db.Decimal(12, 2)
  description String?  @db.VarChar(255)
  isCarryover Boolean  @default(false) @map("is_carryover") // True si proviene del sobrante de un presupuesto previo
  date        DateTime @default(now())
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  budget   Budget         @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category IncomeCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  user     User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([budgetId])
  @@map("incomes")
}

// ------------------------------------------------------
// PRESUPUESTOS, RUBROS Y ASIGNACIONES
// ------------------------------------------------------

model Budget {
  id        String       @id @default(uuid())
  teamId    String       @map("team_id")
  name      String // Ej: "Noviembre 2026" o "Quincena 1"
  startDate DateTime     @map("start_date") @db.Date
  endDate   DateTime     @map("end_date") @db.Date
  status    BudgetStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  team    Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  incomes Income[]
  items   BudgetItem[]
  closing BudgetClosing?

  @@index([teamId, status])
  @@map("budgets")
}

// Rubros proyectados al inicio del presupuesto (ej: Internet Q300)
model BudgetItem {
  id              String   @id @default(uuid())
  budgetId        String   @map("budget_id")
  name            String // Nombre del gasto proyectado
  projectedAmount Decimal  @map("projected_amount") @db.Decimal(12, 2)
  hasUserSplit    Boolean  @default(false) @map("has_user_split") // Activa asignación por miembro del team
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  budget      Budget                 @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  allocations BudgetItemAllocation[]
  expenses    Expense[]

  @@index([budgetId])
  @@map("budget_items")
}

// Cuánto debe poner cada user para cubrir un BudgetItem específico
model BudgetItemAllocation {
  id             String  @id @default(uuid())
  budgetItemId   String  @map("budget_item_id")
  userId         String  @map("user_id")
  assignedAmount Decimal @map("assigned_amount") @db.Decimal(12, 2)

  budgetItem BudgetItem @relation(fields: [budgetItemId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([budgetItemId, userId])
  @@map("budget_item_allocations")
}

// ------------------------------------------------------
// REGISTRO DE GASTOS REALES
// ------------------------------------------------------

model Expense {
  id              String   @id @default(uuid())
  budgetItemId    String   @map("budget_item_id") // Obligatoriamente ligado a un rubro proyectado
  paidByUserId    String   @map("paid_by_user_id") // Persona del team que realizó el gasto
  createdByUserId String   @map("created_by_user_id") // Usuario logueado que digitó el registro
  amount          Decimal  @db.Decimal(12, 2)
  date            DateTime @db.Date
  description     String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  budgetItem BudgetItem @relation(fields: [budgetItemId], references: [id], onDelete: Restrict)
  paidBy     User       @relation("ExpensePayer", fields: [paidByUserId], references: [id], onDelete: Restrict)
  createdBy  User       @relation("ExpenseCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([budgetItemId])
  @@index([paidByUserId])
  @@map("expenses")
}

// ------------------------------------------------------
// CIERRE DE PRESUPUESTO, AHORRO Y SOBRANTES
// ------------------------------------------------------

model BudgetClosing {
  id                   String   @id @default(uuid())
  budgetId             String   @unique @map("budget_id")
  totalIncome          Decimal  @map("total_income") @db.Decimal(12, 2)
  totalSpent           Decimal  @map("total_spent") @db.Decimal(12, 2)
  totalRemainder       Decimal  @map("total_remainder") @db.Decimal(12, 2) // Sobrante total al cerrar
  savedAmount          Decimal  @default(0.00) @map("saved_amount") @db.Decimal(12, 2) // Cuánto se mandó a ahorro
  carriedOverAmount    Decimal  @default(0.00) @map("carried_over_amount") @db.Decimal(12, 2) // Sobrante disponible para el sig. presupuesto
  isCarryoverProcessed Boolean  @default(false) @map("is_carryover_processed") // True si ya se preguntó/transfirió al siguiente presupuesto
  closedAt             DateTime @default(now()) @map("closed_at")

  budget         Budget                       @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  userRemainders BudgetClosingUserRemainder[]

  @@map("budget_closings")
}

// Desglose de cuánto sobrante le pertenece a cada usuario al cerrar el presupuesto
model BudgetClosingUserRemainder {
  id                String  @id @default(uuid())
  budgetClosingId   String  @map("budget_closing_id")
  userId            String  @map("user_id")
  contributedIncome Decimal @map("contributed_income") @db.Decimal(12, 2)
  totalSpent        Decimal @map("total_spent") @db.Decimal(12, 2)
  remainderAmount   Decimal @map("remainder_amount") @db.Decimal(12, 2) // Lo que le sobró a este user

  budgetClosing BudgetClosing @relation(fields: [budgetClosingId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([budgetClosingId, userId])
  @@map("budget_closing_user_remainders")
}

// ------------------------------------------------------
// AUDIT SYSTEM
// ------------------------------------------------------

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?     @map("user_id")
  action     AuditAction
  resource   String // Ej: "budget", "expense", "team_member"
  resourceId String?     @map("resource_id")
  details    Json?
  createdAt  DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
